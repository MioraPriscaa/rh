@{
    TempData.Keep();
    string? currentPage = ViewContext.HttpContext.Request.Path;
}

<!-- Menu -->
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">


    <div class="menu-divider mt-0"></div>
    <div class="menu-inner-shadow"></div>

    <ul class="menu-inner py-1">
        <!-- Dashborad -->
        <li class='menu-item@(currentPage.StartsWith("/FirstPage") ? " active" : "")'>
            <a asp-controller="FirstPage" asp-action="GetActiveAnnonces" class="menu-link">
                <i class="menu-icon icon-base bx bx-home"></i>
                <div class="text-truncate">Liste des annonces</div>
            </a>
        </li>
        <!-- Annonces -->
        <li class='menu-item@(currentPage.StartsWith("/AnnonceCandidat") ? " active" : "")'>
            <a asp-controller="AnnoncesCandidat" asp-action="Index" class="menu-link">
                <i class="menu-icon icon-base bx bx-notification"></i> 
                <div class="text-truncate">Annonces</div>
            </a>
        </li>
    </ul>

</aside>
<!-- / Menu -->
