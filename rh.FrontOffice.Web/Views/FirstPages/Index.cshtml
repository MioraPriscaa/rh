@{
    ViewData["Title"] = "Annonces Actives";
    if (ViewBag.iduser == null)
    {
        Layout = "~/Views/Shared/_BlankLayout.cshtml";
    }
    ViewData["IdUser"] = ViewBag.iduser;
}

@model IEnumerable<rh.Domain.Entities.Annonce>

<div class='layout-wrapper layout-content-navbar'>
    <div class='layout-container'>
        <div class="layout-page">
            @if (ViewBag.iduser == null)
            {
                <nav class="navbar navbar-example navbar-expand-lg bg-body-tertiary">
                    <div class="container-fluid">
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-ex-3">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse" id="navbar-ex-3">
                            <div class="navbar-nav me-auto">
                                <form class="d-flex" onsubmit="return false">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="icon-base bx bx-search"></i></span>
                                        <input type="text" class="form-control" placeholder="Rechercher..." />
                                    </div>
                                </form>
                            </div>

                            <form onsubmit="return false">
                                <a href="@Url.Action("LoginBasic", "Auth")" class="btn btn-primary">Se connecter</a>
                            </form>
                        </div>
                    </div>
                </nav>
            }
            <div class="col-xl-12 p-6">
                <h5 class="pb-1 mb-6">Liste des Annonces</h5>
                <div class="row mb-12 g-6">

                    @foreach (var a in Model)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        @a.Libelle
                                    </h5>
                                    <p class="card-text">Type de contrat : @a.TypeContrat?.Libelle</p>
                                    <p class="card-text">Niveau d'experience : @a.NiveauExperience</p>
                                    <p class="card-text">Mode de travail : @a.ModeTravail?.Libelle</p>
                                    <p class="card-text">Localisation : @a.Localisation</p>
                                    <p><small class="text-body-secondary">Il y a 3 jours</small></p>
                                    <a href="@Url.Action("Details", "FirstPage", new { id = a.Id })" class="btn btn-primary">Voir les détails</a>

                                </div>
                            </div>
                        </div>
                    }


                </div>
            </div>
        </div>
    </div>
</div>
